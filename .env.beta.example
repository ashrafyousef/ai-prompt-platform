# AI Workspace Beta 1.2 — environment template (placeholders only)
#
# Use ONLY with the separate Beta 1.2 Neon project and Vercel beta deployment.
# Do NOT copy production secrets. Do NOT point at production URLs or databases.
#
# Suggested workflow:
#   1. Create clean Neon project `ai-workspace-beta-1-2` (not a branch of production).
#   2. Create separate Vercel project/deployment wired to branch `next/beta-1.2`.
#   3. Set all values below in Vercel → Settings → Environment Variables (beta scope).
#   4. Verify DATABASE_URL hostname/project ID differs from production before migrate/build.

# --- Database (required) ---
# New clean Neon beta project only — never production DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@BETA-NEON-HOST/neondb?sslmode=require"

# --- Auth / URLs (required for deployed beta) ---
# Generate a NEW secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-new-beta-secret-not-production"
# Must match the beta deployment URL exactly (no trailing slash).
NEXTAUTH_URL="https://beta-1-2.example.com"
# Explicit base URL for invite/reset email links (beta domain only).
APP_BASE_URL="https://beta-1-2.example.com"

# --- LLM providers (at least one required for chat) ---
# GROQ_API_KEY takes priority when both are set.
GROQ_API_KEY=""
OPENAI_API_KEY=""

# --- Rate limiting (recommended for beta isolation) ---
# Use a separate Upstash Redis database for beta — do not reuse production Redis.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- File uploads (required on Vercel) ---
# Use a separate Vercel Blob store for beta — do not reuse production Blob token.
BLOB_READ_WRITE_TOKEN=""

# --- Email (optional during early beta) ---
# If unset in production-like NODE_ENV, invitation/reset emails throw EmailDeliveryNotConfigured.
# Use a beta Resend key + beta sender, or leave empty and test invites manually.
RESEND_API_KEY=""
EMAIL_FROM="AI Workspace Beta <beta@example.com>"

# --- Model governance (optional overrides) ---
# CHAT_DEFAULT_MODEL_ID="openai-gpt-5.4-mini"
# CHAT_FALLBACK_MODEL_ID="openai-gpt-4o-mini"
# CHAT_ENABLED_MODEL_IDS="openai-gpt-5.4-mini,openai-gpt-4o-mini"
# CHAT_ROLE_MODEL_ALLOWLIST_JSON='{"USER":["openai-gpt-5.4-mini"],"TEAM_LEAD":["openai-gpt-5.4-mini"],"ADMIN":["openai-gpt-5.4-mini"]}'
# CHAT_DEFAULT_AGENT_ID=""

# --- Token budgets (optional; defaults come from ROLE_LIMITS in code) ---
TOKEN_SOFT_LIMIT="200000"
TOKEN_HARD_LIMIT="250000"
TEAM_TOKEN_SOFT_LIMIT="0"
TEAM_TOKEN_HARD_LIMIT="0"

# --- Chat context (optional) ---
CHAT_CONTEXT_TOKEN_LIMIT="2500"

# --- Local/dev only (do not set on Vercel beta unless intentional) ---
# IMAGE_UPLOAD_LOCAL="1"
# SKIP_MIGRATE_DEPLOY="1"

# --- Seed/bootstrap helpers (local beta DB setup only; not required on Vercel) ---
# ADMIN_SEED_EMAIL="admin@example.com"
# ADMIN_SEED_PASSWORD=""
# ADMIN_SEED_WORKSPACE_NAME="Beta Workspace"
